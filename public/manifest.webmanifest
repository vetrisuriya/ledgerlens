{
  "name": "LedgerLens",
  "short_name": "LedgerLens",
  "description": "Extract payment transaction details from screenshots into an exportable table. Runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./favicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./favicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
